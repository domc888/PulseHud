{
  "schemaVersion": 1,
  "id": "pulsehud",
  "version": "1.0.0",
  "name": "PulseHUD",
  "description": "Client-side PvP HUD and utility mod for Fabric.",
  "authors": ["PulseHUD"],
  "contact": {},
  "license": "MIT",
  "icon": "assets/pulsehud/icon.png",
  "environment": "client",
  "entrypoints": {
